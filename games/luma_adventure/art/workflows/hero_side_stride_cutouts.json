{
  "load": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "luma_hero_side_stride_00001_.png [output]"
    }
  },
  "model": {
    "class_type": "LoadBackgroundRemovalModel",
    "inputs": {
      "bg_removal_name": "birefnet.safetensors"
    }
  },
  "crop_00": {
    "class_type": "ImageCrop",
    "inputs": {
      "image": [
        "load",
        0
      ],
      "width": 512,
      "height": 512,
      "x": 0,
      "y": 0
    }
  },
  "mask": {
    "class_type": "RemoveBackground",
    "inputs": {
      "bg_removal_model": [
        "model",
        0
      ],
      "image": [
        "crop_00",
        0
      ]
    }
  },
  "invert": {
    "class_type": "InvertMask",
    "inputs": {
      "mask": [
        "mask",
        0
      ]
    }
  },
  "rgba": {
    "class_type": "JoinImageWithAlpha",
    "inputs": {
      "image": [
        "crop_00",
        0
      ],
      "alpha": [
        "invert",
        0
      ]
    }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "rgba",
        0
      ],
      "filename_prefix": "luma_hero_side_stride_cutout"
    }
  }
}
