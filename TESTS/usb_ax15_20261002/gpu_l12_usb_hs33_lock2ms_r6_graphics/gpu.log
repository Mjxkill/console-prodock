PORT /dev/ttyACM1
THREED PAUSED
MegaPro GPU G6 FAST TILES AFFINE core=800MHz bus=80MHz
ECHO 1 PASS
ECHO 64 PASS
ECHO 256 PASS
ECHO 1024 PASS
ECHO 4096 PASS
DDR BEGIN core=800MHz bytes=1048576 cache=00000003
DDR MASK begin
DDR MASK errors=0
DDR ADDRESS errors=0
DDR PASS 0 write
DDR timeout; pending=bytearray(b'\r')
