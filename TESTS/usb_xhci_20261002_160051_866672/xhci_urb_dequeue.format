name: xhci_urb_dequeue
ID: 1543
format:
	field:unsigned short common_type;	offset:0;	size:2;	signed:0;
	field:unsigned char common_flags;	offset:2;	size:1;	signed:0;
	field:unsigned char common_preempt_count;	offset:3;	size:1;	signed:0;
	field:int common_pid;	offset:4;	size:4;	signed:1;

	field:__data_loc char[] devname;	offset:8;	size:4;	signed:0;
	field:void * urb;	offset:16;	size:8;	signed:0;
	field:unsigned int pipe;	offset:24;	size:4;	signed:0;
	field:unsigned int stream;	offset:28;	size:4;	signed:0;
	field:int status;	offset:32;	size:4;	signed:1;
	field:unsigned int flags;	offset:36;	size:4;	signed:0;
	field:int num_mapped_sgs;	offset:40;	size:4;	signed:1;
	field:int num_sgs;	offset:44;	size:4;	signed:1;
	field:int length;	offset:48;	size:4;	signed:1;
	field:int actual;	offset:52;	size:4;	signed:1;
	field:int epnum;	offset:56;	size:4;	signed:1;
	field:int dir_in;	offset:60;	size:4;	signed:1;
	field:int type;	offset:64;	size:4;	signed:1;
	field:int slot_id;	offset:68;	size:4;	signed:1;

print fmt: "%s ep%d%s-%s: urb %p pipe %u slot %d length %d/%d sgs %d/%d stream %d flags %08x", __get_str(devname), REC->epnum, REC->dir_in ? "in" : "out", __print_symbolic(REC->type, { 3, "intr" }, { 0, "control" }, { 2, "bulk" }, { 1, "isoc" }), REC->urb, REC->pipe, REC->slot_id, REC->actual, REC->length, REC->num_mapped_sgs, REC->num_sgs, REC->stream, REC->flags
