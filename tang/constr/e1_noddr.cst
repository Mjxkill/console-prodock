// console_e0b.cst — brochage Tang Mega 138K Pro Dock (schéma 4071f rev 1.2).
// Sources : rgb_screen/480_272_screen.cst (LCD + clk P16), usb_ref.cst (soft USB + LEDs + uart V22).
// Device : GW5AST-LV138FPG676AC1/I0 (gw5ast138b-007).

// ---------- horloge ----------
IO_LOC  "clk" P16;
IO_PORT "clk" PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;

// ---------- LCD 480×272 (RGB666 SYNC-DE) ----------
IO_LOC  "lcd_r[0]" K17;
IO_LOC  "lcd_r[1]" J18;
IO_LOC  "lcd_r[2]" H18;
IO_LOC  "lcd_r[3]" G25;
IO_LOC  "lcd_r[4]" J19;
IO_LOC  "lcd_r[5]" H19;
IO_LOC  "lcd_g[0]" G20;
IO_LOC  "lcd_g[1]" G21;
IO_LOC  "lcd_g[2]" G22;
IO_LOC  "lcd_g[3]" F22;
IO_LOC  "lcd_g[4]" K15;
IO_LOC  "lcd_g[5]" J16;
IO_LOC  "lcd_b[0]" M16;
IO_LOC  "lcd_b[1]" M17;
IO_LOC  "lcd_b[2]" F18;
IO_LOC  "lcd_b[3]" F19;
IO_LOC  "lcd_b[4]" G19;
IO_LOC  "lcd_b[5]" F20;
IO_LOC  "lcd_en" A24;
IO_LOC  "lcd_hs" H22;   // MIPI_DPI.HS  (broche 32 du FPC-40)
IO_LOC  "lcd_vs" A23;   // MIPI_DPI.VS  (broche 33 du FPC-40)
IO_LOC  "lcd_bl" F25;   // LCD_BL       (broche 47) : enable du driver de rétroéclairage LP3320
IO_LOC  "lcd_clk" H21;
IO_PORT "lcd_en" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_hs" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_vs" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_bl" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_clk" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_r[0]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_r[1]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_r[2]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_r[3]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_r[4]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_r[5]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_g[0]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_g[1]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_g[2]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_g[3]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_g[4]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_g[5]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_b[0]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_b[1]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_b[2]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_b[3]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_b[4]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_b[5]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// ---------- LEDs utilisateurs ----------
IO_LOC  "led[0]" J14;   // NOTE carte : LED.0 sur banque 2 (J14)
IO_LOC  "led[1]" R26;
IO_LOC  "led[2]" L20;
IO_LOC  "led[3]" M25;
IO_LOC  "led[4]" N21;
IO_LOC  "led[5]" N23;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// ---------- soft USB (port SOFT-USB) ----------
IO_LOC  "usb_dxp_io" M21,M22;
IO_PORT "usb_dxp_io" IO_TYPE=LVPECL33E PULL_MODE=NONE DIFF_RESISTOR=OFF DRIVE=12 BANK_VCCIO=3.3 CTLE=MEDIUM;

IO_LOC  "usb_pullup_en_o" M19;
IO_PORT "usb_pullup_en_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC  "usb_term_dp_io" T19;
IO_PORT "usb_term_dp_io" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "usb_term_dn_io" U19;
IO_PORT "usb_term_dn_io" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC  "usb_rxdp_i" U21,V21;
IO_PORT "usb_rxdp_i" IO_TYPE=LVDS25 PULL_MODE=NONE DIFF_RESISTOR=OFF BANK_VCCIO=3.3 CTLE=MEDIUM;
IO_LOC  "usb_rxdn_i" T20,U20;
IO_PORT "usb_rxdn_i" IO_TYPE=LVDS25 PULL_MODE=NONE DIFF_RESISTOR=OFF BANK_VCCIO=3.3 CTLE=MEDIUM;

// ---------- contraintes de placement des PLL (diagnostic énumération, 2026-09-25) ----------
// La PLL_USB et la PLL_LCD se disputaient une ressource proche (non mesurable : .p chiffrés, V4 § 1).
// Forcé : les 2 PLL USB à droite, la PLL LCD à gauche (SUG935 A.3.2).
INS_LOC "u_pll_f/PLL_inst" PLL_R[0];
INS_LOC "u_pll_b/PLL_inst" PLL_R[1];
INS_LOC "u_pll_lcd/PLL_inst" PLL_L[1];

