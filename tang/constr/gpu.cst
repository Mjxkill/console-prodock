IO_LOC "ae350_tms" E25;  IO_PORT "ae350_tms" IO_TYPE=LVCMOS33 PULL_MODE=UP;    // J7 IO1 (J-Link TMS)
IO_LOC "ae350_tck" C24;  IO_PORT "ae350_tck" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;  // J7 IO0 (J-Link TCK)
IO_LOC "ae350_tdo" H14;  IO_PORT "ae350_tdo" IO_TYPE=LVCMOS33 DRIVE=8;         // J7 IO3 (J-Link TDO)
IO_LOC "ae350_tdi" L18;  IO_PORT "ae350_tdi" IO_TYPE=LVCMOS33 PULL_MODE=UP;    // J7 IO6 (J-Link TDI)
IO_LOC "ae350_tx_pin" H15;  IO_PORT "ae350_tx_pin" IO_TYPE=LVCMOS33 DRIVE=8;   // J7 IO7 : espion UART2 TX (mesurable)

// ---------- E2 : CLOCK_LOC du socle analyseur (la16.cst V3, adapté : u_soc) ----------
CLOCK_LOC "u_soc/hrst_sync[1]" LOCAL_CLOCK;
CLOCK_LOC "u_soc/exts_hrstn" LOCAL_CLOCK;   // reset du pont EXTS : figé à 0 sur LW sinon (la16.cst)
CLOCK_LOC "u_soc/ddr3_init_completed" LOCAL_CLOCK;
// exts_hrstn : optimisé hors synthèse dans ce design (pas de CLOCK_LOC possible)
CLOCK_LOC "rtc_clk" LOCAL_CLOCK;
// ---------- E2 : PLL DDR3 (socle analyseur) à gauche, près du PHY DDR3 ----------
INS_LOC "u_soc/u_pll_ddr3/u_pll/PLL_inst" PLL_L[0];
// ---------- E2 : u_dll/fclkdiv du PHY DDR3 standalone (chemins la16.cst, adapté) ----------
INS_LOC "u_soc/g_ddr.u_ddr/u_ip/gw3_top/u_ddr_phy_top/u_dll" DDRDLLM_BL;
INS_LOC "u_soc/g_ddr.u_ddr/u_ip/gw3_top/u_ddr_phy_top/fclkdiv" LEFTSIDE[4];

