// gpu.cst — brochage Tang Mega 138K Pro Dock (schéma 4071f rev 1.2).
// Sources : rgb_screen/480_272_screen.cst (LCD + clk P16), usb_ref.cst (soft USB + LEDs + uart V22).
// Device : GW5AST-LV138FPG676AC1/I0 (gw5ast138b-007).

// ---------- horloge ----------
IO_LOC  "clk" P16;
IO_PORT "clk" PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;

// ---------- LCD 800×480 (RGB666 SYNC-DE) ----------
IO_LOC  "lcd_r[0]" K17;
IO_LOC  "lcd_r[1]" J18;
IO_LOC  "lcd_r[2]" H18;
IO_LOC  "lcd_r[3]" G25;
IO_LOC  "lcd_r[4]" J19;
IO_LOC  "lcd_r[5]" H19;
IO_LOC  "lcd_g[0]" G20;
IO_LOC  "lcd_g[1]" G21;
IO_LOC  "lcd_g[2]" G22;
IO_LOC  "lcd_g[3]" F22;
IO_LOC  "lcd_g[4]" K15;
IO_LOC  "lcd_g[5]" J16;
IO_LOC  "lcd_b[0]" M16;
IO_LOC  "lcd_b[1]" M17;
IO_LOC  "lcd_b[2]" F18;
IO_LOC  "lcd_b[3]" F19;
IO_LOC  "lcd_b[4]" G19;
IO_LOC  "lcd_b[5]" F20;
IO_LOC  "lcd_en" A24;
IO_LOC  "lcd_hs" H22;   // MIPI_DPI.HS  (broche 32 du FPC-40)
IO_LOC  "lcd_vs" A23;   // MIPI_DPI.VS  (broche 33 du FPC-40)
IO_LOC  "lcd_bl" F25;   // LCD_BL       (broche 47) : enable du driver de rétroéclairage LP3320
IO_LOC  "lcd_clk" H21;
IO_PORT "lcd_en" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_hs" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_vs" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_bl" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_clk" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_r[0]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_r[1]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_r[2]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_r[3]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
