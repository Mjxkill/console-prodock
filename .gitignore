# artefacts de build (bitstreams et rapports volumineux : conservés hors git, régénérables)
tang/impl/gwsynthesis/
tang/impl/pnr/*.html
tang/impl/pnr/*.power.html
tang/impl/pnr/*.pin.html
*.log
!TESTS/**/*.log
# Caches Verilator régénérables ; les sources et journaux des bancs restent suivis.
TESTS/**/obj/
TESTS/**/obj_dir/
*.jou
__pycache__/
# bitstreams validés : archivés et versionnés dans bitstreams/
tang/impl/pnr/*.fs
tang/impl/pnr/*.pr
tang/impl/diag_pllr0/
tang/impl/gpu_*/
# Témoins USB : preuves et entrées nécessaires archivées sous TESTS/.
tang/impl/usb_sipeed_*/
# Nouveaux résultats intermédiaires (les anciens fichiers suivis restent inchangés).
tang/impl/pnr/
fw_console/build/
fw_console/**/*.bin
fw_console/**/*.elf
fw_console/**/*.map
fw_console/mini/itcm*/
# Sauvegarde locale antérieure aux corrections ; sources qualifiées archivées séparément.
/TESTS/reprise_20261007/sources_avant_corrections.tar.gz
# Les netlists IP utilisées par les builds sont les .v ; sorties et caches du générateur.
tang/ref_demo/**/temp/
tang/rtl/ae350/**/temp/
tang/ref_demo_cfg/*.vg
tang/ref_demo_cfg/*_syn*
tang/rtl/board/**/*.vg
tang/rtl/board/**/*_syn*
# Linux/OpenSBI/rootfs outputs and extracted upstream sources.
/linux/build/

# Isolated Neo builds; source and test reports are tracked separately.
tang/impl/console_neo_*/
/linux/build-neo/

TESTS/neo_usbhost/sim_build*/

# Local optimizer toolchain and reproducible run artifacts.
/optimizer/.tools/
/optimizer/runs/
/TESTS/neo_pending_validation.lock

# Jeux : sorties de construction, captures et snapshots de candidats.
# Les sources, ressources et rapports texte restent suivis.
/games/luma3d/build/
/games/luma3d/build-kernel/
/games/luma3d/candidates/
/games/luma3d/art/candidates_*/
/games/luma3d/tests/hardware/
/games/luma3d/tests/paths_native_oracle_20261026_r1/
/games/luma_adventure/build/

# Preuves volumineuses régénérables ; textes, journaux et petits JSON restent suivis.
TESTS/**/*.vvp
TESTS/**/*.pr
TESTS/**/*.o
TESTS/**/*.a
TESTS/**/*.so
TESTS/**/*.bin
TESTS/**/*.fs
TESTS/**/*.png
TESTS/**/*.jpg
TESTS/**/*.jpeg
TESTS/**/*.gif
TESTS/**/*.mp4
TESTS/**/*.wav
TESTS/**/*.tar
TESTS/**/*.tar.gz
TESTS/**/*.zip
TESTS/**/node_modules/

# Caches régénérables et métadonnées locales ; sources et preuves conservées.
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
/.aws/
/.opencode/
# Les fichiers de verrou ne constituent pas des résultats de diagnostic.
TESTS/**/*.lock
TESTS/**/.lock

# Per-mission authentication and OpenCode runtime state are local artifacts.
# Keep sanitized receipts/results outside these directories.
TESTS/**/controller/opencode.json
TESTS/**/controller/data/
TESTS/**/controller/cache/
TESTS/**/controller/state/
TESTS/**/.npm/

# Downloaded upstream archives and optional vendor comparison checkout.
/linux/downloads/
/external/

# Personal assistant/session instructions are not part of the public project.
AGENTS.md
CLAUDE.md
GLOBAL_AGENTS.md
# Historical bitstreams remain in Git history and local reference archives.
/bitstreams/**/*.fs
/bitstreams/*.tar.gz
/build/

# Campaign outputs stay local; publish only selected evidence explicitly.
/TESTS/*/
!/TESTS/rtl/
!/TESTS/host/
/games/*/tests/hardware/
/games/*/tests/*/baseline/
